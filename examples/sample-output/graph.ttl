@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qms: <http://example.org/qms#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/qms> a owl:Ontology ;
    rdfs:label "Quality Records Demo Ontology (synthetic)" ;
    rdfs:comment "A small ontology for linking quality records (deviations, investigations, CAPA) to products, equipment, and sites. All data in this project is synthetic." .

qms:aboutEquipment a owl:ObjectProperty ;
    rdfs:comment "A piece of equipment the record concerns. Only confirmed links are stored." ;
    rdfs:domain qms:QualityRecord ;
    rdfs:range qms:Equipment .

qms:aboutProduct a owl:ObjectProperty ;
    rdfs:comment "A product the record concerns. Only confirmed links are stored." ;
    rdfs:domain qms:QualityRecord ;
    rdfs:range qms:Product .

qms:correctiveActionFor a owl:ObjectProperty ;
    rdfs:domain qms:CAPA ;
    rdfs:range qms:Investigation .

qms:description a owl:DatatypeProperty ;
    rdfs:domain qms:QualityRecord ;
    rdfs:range xsd:string .

qms:equipmentAt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain qms:Equipment ;
    rdfs:range qms:Site .

qms:equipmentType a owl:DatatypeProperty ;
    rdfs:domain qms:Equipment ;
    rdfs:range xsd:string .

qms:investigates a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain qms:Investigation ;
    rdfs:range qms:Deviation .

qms:occurredAt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The site where the record was raised." ;
    rdfs:domain qms:QualityRecord ;
    rdfs:range qms:Site .

qms:openedOn a owl:DatatypeProperty ;
    rdfs:domain qms:QualityRecord ;
    rdfs:range xsd:date .

qms:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Physical containment: equipment is part of a line or area, a line is part of an area, and an area is part of a site." .

qms:recordId a owl:DatatypeProperty ;
    rdfs:domain qms:QualityRecord ;
    rdfs:range xsd:string .

