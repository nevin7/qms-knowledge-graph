qms:Line a owl:Class ;
    rdfs:label "Production line" ;
    owl:disjointWith qms:Site .

qms:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:subClassOf skos:Concept .

qms:Site a owl:Class ;
    rdfs:label "Site" .

qms:Area a owl:Class ;
    rdfs:label "Area" ;
    owl:disjointWith qms:Line,
        qms:Site .

qms:QualityRecord a owl:Class ;
    rdfs:label "Quality record" .

qms:CAPA a owl:Class ;
    rdfs:label "Corrective and preventive action (CAPA)" ;
    rdfs:subClassOf qms:QualityRecord .

qms:Equipment a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:subClassOf skos:Concept .

qms:Investigation a owl:Class ;
    rdfs:label "Investigation" ;
    rdfs:subClassOf qms:QualityRecord ;
    owl:disjointWith qms:CAPA .

<http://example.org/qms/data/site/SITE-S> a qms:Site ;
    rdfs:label "Plant South" .

qms:Deviation a owl:Class ;
    rdfs:label "Deviation" ;
    rdfs:subClassOf qms:QualityRecord ;
    owl:disjointWith qms:CAPA,
        qms:Investigation .

<http://example.org/qms/data/site/SITE-E> a qms:Site ;
    rdfs:label "Plant East" .

